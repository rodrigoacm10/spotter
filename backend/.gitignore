# ==========================================
# Backend (Django) .gitignore
# ==========================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
venv/
.venv/
env/
ENV/

# Database
db.sqlite3
db.sqlite3-journal

# Media / Uploaded files
media/

# Environment and secrets
.env
local_settings.py

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
nosetests.xml
coverage.xml
*.cover

# Logs
*.log
logs/
