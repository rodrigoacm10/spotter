# ==========================================
# Spotter Monorepo .gitignore
# ==========================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs and Editors
.idea/
.vscode/*
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.env
!*.env.example

# Python / Django (Backend)
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/*.so
**/.Python
**/venv/
**/.venv/
**/env/
**/ENV/
**/build/
**/develop-eggs/
**/dist/
**/downloads/
**/eggs/
**/.eggs/
**/lib/
**/lib64/
**/parts/
**/sdist/
**/var/
**/wheels/
**/*.egg-info/
**/.installed.cfg
**/*.egg
**/*.manifest
**/*.spec
**/db.sqlite3
**/db.sqlite3-journal
**/media/
**/.pytest_cache/
**/.coverage
**/htmlcov/

# Node / React Vite (Frontend)
**/node_modules/
**/dist/
**/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
**/.npm
**/.eslintcache
**/.turbo

# Logs
logs/
*.log


# Internal notes & test instructions
docs/
docs

tasks